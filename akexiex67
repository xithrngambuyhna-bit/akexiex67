-- 4. ปุ่มถอดกราบ / ชุดเกราะรถ
local removePartsBtn = Instance.new("TextButton")
removePartsBtn.Text = "🛠️ ถอดกราบ / ชิ้นส่วนรถ"
removePartsBtn.Size = UDim2.new(1, 0, 0, 35)
removePartsBtn.Position = UDim2.new(0, 0, 0, 115)
removePartsBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 0)
removePartsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
removePartsBtn.Font = Enum.Font.SourceSansBold
removePartsBtn.TextSize = 15
removePartsBtn.Parent = contentContainer

removePartsBtn.MouseButton1Click:Connect(function()
	local character = player.Character
	if character and character:FindFirstChild("Humanoid") then
		local seat = character.Humanoid.SeatPart
		if seat and seat:IsA("VehicleSeat") then
			local vehicle = seat:FindFirstAncestorOfClass("Model")
			if vehicle then
				-- คำค้นหาชิ้นส่วนที่จะถูกถอดออก (กราบ, ชุดแต่ง, กันชน ฯลฯ)
				local partsToRemove = {"BodyKit", "Armor", "Bumper", "Spoiler", "Skirt", "Fender", "Decoration", "กราบ"}
				
				for _, child in pairs(vehicle:GetDescendants()) do
					for _, name in pairs(partsToRemove) do
						if string.find(string.lower(child.Name), string.lower(name)) then
							child:Destroy()
						end
					end
				end
				print("ถอดชิ้นส่วนรถเรียบร้อยแล้ว!")
			end
		else
			warn("คุณต้องนั่งอยู่บนรถเพื่อถอดชิ้นส่วน!")
		end
	end
end)

-- 5. ระบบขยับ/ลากเมนู (Draggable System)
local dragging, dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

topBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)
